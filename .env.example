# Public project configuration; safe to expose to browser clients.
# Copy to .env.local and replace with the intended Supabase/Lovable project.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Optional SSR configuration for the same backend. Never place a secret key in VITE_*.
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
