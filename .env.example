# Public project configuration; safe to expose to browser clients.
# Copy to .env.local and replace with the intended Supabase project.
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Never place a secret, service_role key or SMTP credential in VITE_*.
