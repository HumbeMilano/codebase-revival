{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skendal-app",
  "main": "workers/app.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SUPABASE_URL": "https://rwbeiestzyzceramgtdw.supabase.co",
    "SUPABASE_PUBLIC_KEY": "sb_publishable_Aal707QWHprU7mfaJMbrnw_Xw3Ycei7",
  },
  "secrets": { "required": ["RESEND_API_KEY"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application",
  },
  "routes": [{ "pattern": "app.skendal.com", "custom_domain": true }],
}
