{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skendal-app",
  "main": "workers/app.ts",
  "compatibility_date": "2026-10-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "SUPABASE_URL": "https://rwbeiestzyzceramgtdw.supabase.co",
    "SUPABASE_PUBLIC_KEY": "sb_publishable_Aal707QWHprU7mfaJMbrnw_Xw3Ycei7",
  },
  "secrets": {
    "required": [
      "RESEND_API_KEY",
      "TABLET_PAIRING_KEY",
      "SecreteStripe",
      "BILLING_GATEWAY_KEY",
      "STRIPE_WEBHOOK_SECRET",
    ],
  },
  "ratelimits": [
    {
      "name": "WEATHER_RATE",
      "namespace_id": "2026102401",
      "simple": { "limit": 10, "period": 60 },
    },
    {
      "name": "TABLET_PAIRING_RATE",
      "namespace_id": "20261022",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    { "pattern": "app.skendal.com", "custom_domain": true },
    { "pattern": "admin.skendal.com", "custom_domain": true },
  ],
}
